# Eigene Domain statt sync.example.org eintragen. Caddy holt das
# TLS-Zertifikat selbst (Let's Encrypt). Caddy schreibt ohne `log`-Direktive
# keine Zugriffsprotokolle – so bleibt es.
sync.example.org {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy sync:8743
	request_body {
		max_size 8MB
	}
}

